# Example — copy to deploy-production.env (gitignored) hoặc dùng staging.env
# SoT: docs/SoT — Deployment.md

DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=7878
# DEPLOY_HOST=  (origin — đọc từ staging.env, không hardcode vào chat)
# DEPLOY_SSH_PASSWORD=  (staging.env)

DEPLOY_WEB_PRODUCTION=/var/www/iflux/production
DEPLOY_BACKEND=/var/iflux/backend
DEPLOY_STORAGE=/var/iflux/storage
PM2_APP_NAME=iflux-api

# Map 4 files Wave F:
# $DEPLOY_BACKEND/src/modules/market/market-wave-f.service.js
# $DEPLOY_BACKEND/src/modules/market/market-wave-f.routes.js
# $DEPLOY_WEB_PRODUCTION/Admin_Design_system/app/market/stocks.html
# $DEPLOY_WEB_PRODUCTION/Admin_Design_system/app/market/market-stocks-page.js
