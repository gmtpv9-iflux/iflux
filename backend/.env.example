# Local development
APP_ENV=local
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://localhost:5432/iflux_dev
DATABASE_ADMIN_URL=postgresql://localhost:5432/postgres
DATABASE_NAME=iflux_dev
DATABASE_USER=iflux
DATABASE_PASSWORD=iflux_local

REDIS_URL=redis://localhost:6379

JWT_SECRET=iflux-local-dev-change-in-production
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

CORS_ORIGIN=*
LOG_LEVEL=info

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

QUEUE_ENABLED=false
SCHEDULER_ENABLED=true

API_PREFIX=/v1
LEGACY_API_PREFIX=/api
ADMIN_API_KEY=iflux-admin-local-dev

# Email OTP — Adapter Pattern (OtpService → Resend | SMTP)
# Ưu tiên Resend khi có RESEND_API_KEY; đổi provider chỉ cần sửa EMAIL_PROVIDER
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="iFlux <noreply@iflux.vn>"
RESEND_FROM="iFlux <noreply@iflux.vn>"

# Fallback SMTP (nếu không dùng Resend)
EMAIL_OTP_DEMO_CODE=123456
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="iFlux <your-email@gmail.com>"

# DNS bắt buộc khi gửi OTP production (cấu hình trên domain iflux.vn):
# SPF, DKIM, DMARC — xem Resend Dashboard → Domains

# Social login (OAuth)
GOOGLE_CLIENT_ID=
# Gmail được phép đăng nhập Admin (phân tách bằng dấu phẩy)
ADMIN_ALLOWED_EMAILS=your-admin@gmail.com
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OAUTH_REDIRECT_URI=http://103.154.177.157/User_Web/auth/login.html

# Cloudflare Turnstile — chống spam form Liên hệ hợp tác
# Site key dùng ở frontend (public), Secret key verify phía server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
